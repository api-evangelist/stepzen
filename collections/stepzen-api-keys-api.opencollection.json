{
  "opencollection": "1.0.0",
  "info": {
    "name": "StepZen Admin Account API Keys API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dashboard.ibm.stepzen.com/api/v1/api-keys"
          },
          "docs": "List all API keys in the account."
        },
        {
          "info": {
            "name": "Create API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://dashboard.ibm.stepzen.com/api/v1/api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API key for accessing GraphQL endpoints."
        },
        {
          "info": {
            "name": "Delete API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://dashboard.ibm.stepzen.com/api/v1/api-keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "Unique API key identifier"
              }
            ]
          },
          "docs": "Delete an API key."
        }
      ]
    }
  ],
  "bundled": true
}